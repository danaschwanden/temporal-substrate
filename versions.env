# Pinned versions. The toolbox exports them, and the docker builds in getting-started.md pass them with --build-arg NAME.

# Agent Substrate (installed on kind; its generated API is compiled into the provider)
SUBSTRATE_REF=94e0a26ac90151886a76410568aaac2664a54d90
# Temporal server, and the Worker Controller (WCI) commit it pins in its go.mod
TEMPORAL_REF=03ecd1d228d2b8d9d433da55785afc9aeeead918
WCI_REF=75274b664c29740d620c74f80c2f90128506b628
# Temporal Go SDK and API, the versions TEMPORAL_REF uses
TEMPORAL_SDK_VERSION=v1.49.0
TEMPORAL_API_VERSION=v1.64.3
# Toolbox
GO_IMAGE=golang:1.27
KUBECTL_VERSION=v1.34.2
